# Required on Vercel so multiplayer uses the same Cloudflare D1 database.
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# with Account → D1 → Edit (or use a custom token with D1 Read + D1 Write).

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=d6c48e9d-b2f7-4ad3-8c7e-1765f305c361
